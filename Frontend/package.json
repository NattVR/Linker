{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:performance": "ng test --include src/performance-test-entry.spec.ts --watch=false",
    "test:regression": "ng test --include src/checks-entry.spec.ts --watch=false --browsers=ChromeHeadlessCI",
    "test:lighthouse": "node tests/lighthouse/lighthouse-runner.js",
    "test:ai": "node --experimental-vm-modules node_modules/.bin/jest --config=tests-AI/jest.config.js --runInBand",
    "test:ai:watch": "node --experimental-vm-modules node_modules/.bin/jest --config=tests-AI/jest.config.js --watch"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.2.0",
    "@angular/compiler": "^20.2.0",
    "@angular/core": "^20.2.0",
    "@angular/forms": "^20.2.0",
    "@angular/platform-browser": "^20.2.0",
    "@angular/router": "^20.2.0",
    "@fortawesome/fontawesome-free": "^7.1.0",
    "rxjs": "~7.8.0",
    "sweetalert2": "^11.23.0",
    "swiper": "^12.0.2",
    "tslib": "^2.3.0",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.2.0",
    "@angular/cli": "^20.3.2",
    "@angular/compiler-cli": "^20.2.0",
    "@browserbasehq/stagehand": "^3.4.0",
    "@types/cypress": "^0.1.6",
    "@types/jasmine": "~5.1.0",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.1",
    "baseline-browser-mapping": "^2.9.11",
    "chrome-launcher": "^1.2.1",
    "cypress": "^15.14.1",
    "dotenv": "^17.4.2",
    "jasmine-core": "~5.9.0",
    "jest": "^30.4.2",
    "jest-preset-angular": "^16.1.4",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "lcov-result-merger": "^5.0.1",
    "lighthouse": "^12.8.2",
    "puppeteer": "^24.42.0",
    "ts-jest": "^29.4.10",
    "typescript": "~5.9.2"
  }
}
